{
  "name": "graphql-testing-framework",
  "version": "1.0.0",
  "description": "GraphQL API integration test suite (Jest + TypeScript) across four public APIs",
  "private": true,
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [
    "graphql",
    "api-testing",
    "jest",
    "typescript"
  ],
  "author": "Kushan Parikh",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.9",
    "jest": "^30.2.0",
    "jest-html-reporters": "^3.1.7",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0"
  }
}
